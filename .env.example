# Copy to .env and adjust. Every value has a working default, so the stack starts
# with no configuration at all - but change the database password before exposing it.

# --- database -----------------------------------------------------------------
POSTGRES_DB=objecthub
POSTGRES_USER=objecthub
POSTGRES_PASSWORD=change-me

# Only used by the dev overlay, which publishes PostgreSQL on the host.
POSTGRES_PORT=5432

# --- application --------------------------------------------------------------
APP_NAME=Object Hub

# Host port the UI is served on.
APP_PORT=8080

# Optional. Shown next to printed labels as a hint for where to browse to.
# QR payloads stay relative regardless, so labels work on any hostname.
BASE_URL=

# Only needed when running the app outside Docker against a local PostgreSQL.
# DATABASE_URL=postgresql+psycopg://objecthub:objecthub@localhost:5432/objecthub
# DATA_DIR=./var
